#!/bin/bash

#Define the Output file name
OUTPUT_FILE="$HOME/scripts/recon_output.txt"

#Clear previous contents if file already exists
> "$OUTPUT_FILE"

echo "==== RECONNAISSANCE REPORT ====" >> "$OUTPUT_FILE"
echo "Generated on:$(date)" >>  "$OUTPUT_FILE"
echo "--------------------------------" >> "$OUTPUT_FILE"

#Display & save the OS Information
echo "[+] OS Information:" >> "$OUTPUT_FILE"
uname -a >> "$OUTPUT_FILE"
echo "" >> "$OUTPUT_FILE"

#Display & save logged-in users and current user
echo "[+] Logged-in Users:" >> "$OUTPUT_FILE"
w | sed -n "2,3p" >> "$OUTPUT_FILE"
echo "" >> "$OUTPUT_FILE"
echo "[+] Current User:" >> "$OUTPUT_FILE"
whoami >> "$OUTPUT_FILE"
echo "" >> "$OUTPUT_FILE"


#Display & save uptime
echo "[+] System Uptime:" >> "$OUTPUT_FILE"
uptime >> "$OUTPUT_FILE"
echo "" >> "$OUTPUT_FILE"

#Notify the user on the terminal
echo "Recon complete! Output saved to $OUTPUT_FILE"

